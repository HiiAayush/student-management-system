@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

/* =========================================================
   StudentHub — Professional Blue & White Theme
   ========================================================= */
:root {
  /* Brand blues */
  --blue-50: #eff6ff;
  --blue-100: #dbeafe;
  --blue-200: #bfdbfe;
  --blue-300: #93c5fd;
  --blue-400: #60a5fa;
  --blue-500: #3b82f6;
  --blue-600: #2563eb;
  --blue-700: #1d4ed8;
  --sky-50: #f0f9ff;
  --sky-100: #e0f2fe;
  --sky-600: #0284c7;
  --cyan-50: #ecfeff;
  --cyan-100: #cffafe;
  --cyan-700: #0e7490;

  /* Navy (sidebar) */
  --navy-900: #0a1b3d;
  --navy-800: #0f2550;
  --navy-700: #16326a;
  --navy-600: #1f4080;

  /* Neutrals (blue-gray) */
  --bg: #f1f5fb;
  --surface: #ffffff;
  --surface-alt: #f8fafd;
  --border: #e2e8f3;
  --border-soft: #edf1f8;
  --text: #0f1f3d;
  --text-strong: #14274e;
  --text-body: #475a7c;
  --text-muted: #7487a6;
  --text-faint: #9aabc4;

  /* Semantic */
  --success: #16a37f;
  --success-bg: #e8f8f3;
  --warning: #e5a02f;
  --danger: #dc4b5d;
  --danger-dark: #b83a4b;
  --danger-bg: #fff1f3;
  --danger-border: #fbd5da;

  /* Effects */
  --shadow-sm: 0 1px 2px rgba(15, 37, 80, 0.04), 0 2px 8px rgba(15, 37, 80, 0.04);
  --shadow-md: 0 4px 18px rgba(15, 37, 80, 0.07);
  --shadow-lg: 0 10px 35px rgba(15, 37, 80, 0.14);
  --focus-ring: 0 0 0 3px rgba(37, 99, 235, 0.16);

  font-family: 'DM Sans', sans-serif;
  color: var(--text);
  background: var(--bg);
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  font-weight: 400;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; }
button, input, select { font: inherit; }
button { cursor: pointer; }
button:disabled { opacity: 0.6; cursor: not-allowed; }

.app-shell { min-height: 100vh; }

/* ---------- Sidebar ---------- */
.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 246px;
  background: linear-gradient(180deg, var(--navy-900) 0%, var(--navy-800) 100%);
  color: #e3ecff;
  padding: 27px 17px;
  display: flex;
  flex-direction: column;
  z-index: 3;
  box-shadow: 2px 0 18px rgba(10, 27, 61, 0.12);
}

.brand { display: flex; align-items: center; gap: 11px; padding: 0 9px 39px; }
.brand-icon {
  width: 42px;
  height: 42px;
  border-radius: 13px;
  background: linear-gradient(145deg, var(--blue-500), var(--blue-700));
  display: grid;
  place-items: center;
  color: #fff;
  box-shadow: 0 8px 20px rgba(37, 99, 235, 0.38);
}
.brand strong { display: block; font: 800 18px Manrope, sans-serif; letter-spacing: -0.5px; color: #fff; }
.brand span { display: block; font-size: 9px; letter-spacing: 1.4px; color: #8fa6d0; margin-top: 4px; }

.side-label { font-size: 10px; font-weight: 700; letter-spacing: 1.5px; color: #7f97c4; padding: 0 12px 12px; }

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 12px;
  border-radius: 9px;
  font-size: 13px;
  color: #b4c5e6;
  transition: background 0.15s ease, color 0.15s ease;
}
.nav-item:hover { background: rgba(255, 255, 255, 0.06); color: #fff; }
.nav-item.active { background: var(--navy-600); color: #fff; font-weight: 600; box-shadow: inset 3px 0 0 var(--blue-400); }
.nav-count { margin-left: auto; font-size: 11px; background: var(--blue-600); color: #fff; border-radius: 5px; padding: 3px 7px; }

.sidebar-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 11px;
  border-top: 1px solid var(--navy-700);
  padding: 18px 10px 0;
}
.sidebar-bottom strong, .sidebar-bottom span { display: block; font-size: 11px; }
.sidebar-bottom strong { color: #e3ecff; }
.sidebar-bottom span { color: #8fa6d0; margin-top: 4px; }

/* ---------- Status indicators ---------- */
.status-dot, .tiny-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--warning); display: inline-block; }
.status-dot.online, .tiny-dot.online { background: #34d399; }
.status-dot.offline, .tiny-dot.offline { background: #f87185; }

/* ---------- Main layout ---------- */
.main { margin-left: 246px; min-height: 100vh; }

.topbar {
  height: 72px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  box-shadow: 0 1px 3px rgba(15, 37, 80, 0.03);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42px;
}
.crumb { font-size: 12px; color: var(--text-faint); }
.crumb span { padding: 0 9px; color: #c3cfe2; }
.crumb strong { color: var(--text-strong); }
.top-right { display: flex; align-items: center; gap: 20px; }
.secure { font-size: 11px; color: var(--text-muted); display: flex; align-items: center; gap: 7px; }
.secure span { width: 7px; height: 7px; border-radius: 50%; background: #34d399; }
.avatar {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--blue-100);
  color: var(--blue-700);
  font-size: 11px;
  font-weight: 700;
}

.content { max-width: 1400px; padding: 39px 42px 24px; margin: auto; }

.page-heading { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 29px; }
.eyebrow { font-size: 10px; font-weight: 700; letter-spacing: 1.65px; color: var(--blue-600); }
.page-heading h1 { font: 800 clamp(25px, 3vw, 32px) Manrope, sans-serif; letter-spacing: -1.2px; margin: 8px 0; color: var(--text); }
.page-heading p, .panel-header p { margin: 0; color: var(--text-muted); font-size: 13px; }

/* ---------- Buttons ---------- */
.primary-btn, .secondary-btn {
  border: 0;
  border-radius: 8px;
  padding: 11px 16px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
  transition: background 0.15s ease, box-shadow 0.15s ease, color 0.15s ease;
}
.primary-btn { background: var(--blue-600); color: #fff; box-shadow: 0 5px 12px rgba(37, 99, 235, 0.25); }
.primary-btn:hover { background: var(--blue-700); box-shadow: 0 6px 16px rgba(29, 78, 216, 0.32); }
.secondary-btn { background: var(--blue-50); color: var(--blue-700); }
.secondary-btn:hover { background: var(--blue-100); }

/* ---------- Stats ---------- */
.stats-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-bottom: 23px; }
.stat-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
  display: flex;
  gap: 15px;
  align-items: center;
  min-height: 112px;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 0.15s ease, border-color 0.15s ease;
}
.stat-card:hover { box-shadow: var(--shadow-md); border-color: var(--blue-200); }
.stat-icon { width: 43px; height: 43px; display: grid; place-items: center; border-radius: 12px; }
.stat-icon.purple { background: var(--blue-50); color: var(--blue-600); }
.stat-icon.blue { background: var(--sky-100); color: var(--sky-600); }
.stat-icon.green { background: var(--cyan-100); color: var(--cyan-700); }
.stat-card span, .stat-card small { display: block; color: var(--text-muted); font-size: 11px; }
.stat-card strong { display: block; font: 800 25px Manrope, sans-serif; margin: 4px 0 2px; letter-spacing: -0.5px; color: var(--text); }
.stat-card small { font-size: 10px; color: var(--text-faint); }

/* ---------- Panel ---------- */
.panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 13px;
  overflow: hidden;
  box-shadow: var(--shadow-md);
}
.panel-header { padding: 22px 24px 18px; display: flex; align-items: center; justify-content: space-between; }
.panel-header h2 { font: 800 17px Manrope, sans-serif; margin: 0 0 5px; letter-spacing: -0.4px; color: var(--text); }
.panel-header p { font-size: 11px; }

.icon-btn {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--surface);
  color: var(--text-muted);
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}
.icon-btn:hover { background: var(--blue-50); color: var(--blue-600); border-color: var(--blue-200); }

/* ---------- Toolbar & search ---------- */
.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 0 24px 18px; }
.search-box {
  height: 39px;
  width: min(450px, 100%);
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text-faint);
  background: var(--surface);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.search-box:focus-within { border-color: var(--blue-400); box-shadow: var(--focus-ring); }
.search-box input { border: 0; outline: 0; min-width: 0; flex: 1; font-size: 11px; color: var(--text-strong); background: transparent; }
.search-box input::placeholder { color: #a3b3cc; }
.search-box button { border: 0; background: none; color: var(--text-muted); display: grid; place-items: center; }
.search-box button:hover { color: var(--blue-600); }
.result-count { font-size: 10px; color: var(--text-muted); white-space: nowrap; }

/* ---------- Table ---------- */
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; text-align: left; white-space: nowrap; }
thead { background: var(--surface-alt); }
th {
  padding: 12px 15px;
  font-size: 9px;
  letter-spacing: 0.8px;
  color: var(--text-muted);
  font-weight: 700;
  border-top: 1px solid var(--border-soft);
  border-bottom: 1px solid var(--border-soft);
}
th:first-child, td:first-child { padding-left: 24px; }
th:last-child, td:last-child { padding-right: 24px; }
.actions-heading { text-align: right; }
td { padding: 15px; border-bottom: 1px solid var(--border-soft); font-size: 11px; color: var(--text-body); }
tbody tr { transition: background 0.12s ease; }
tbody tr:last-child td { border-bottom: 0; }
tbody tr:hover { background: var(--sky-50); }

.student-cell { display: flex; align-items: center; gap: 10px; }
.student-avatar {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: var(--blue-100);
  color: var(--blue-700);
  font-size: 10px;
  font-weight: 800;
}
.student-cell strong, .student-cell span { display: flex; align-items: center; gap: 5px; }
.student-cell strong { font-size: 11px; color: var(--text-strong); font-weight: 700; }
.student-cell span { font-size: 10px; color: var(--text-faint); margin-top: 5px; }

.id-pill {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  background: #eef2f9;
  border-radius: 5px;
  padding: 5px 7px;
  color: var(--text-body);
  font-size: 10px;
  font-weight: 600;
}
.department { color: #3d5075; }
.semester-pill {
  display: inline-block;
  background: var(--blue-50);
  color: var(--blue-700);
  border: 1px solid var(--blue-100);
  border-radius: 5px;
  padding: 4px 8px;
  font-size: 10px;
  font-weight: 600;
}
.contact { color: var(--text-muted); }

/* ---------- Row actions ---------- */
.row-actions { display: flex; justify-content: flex-end; gap: 7px; }
.row-actions button {
  width: 29px;
  height: 29px;
  display: grid;
  place-items: center;
  border-radius: 7px;
  background: var(--surface);
  transition: background 0.15s ease, border-color 0.15s ease;
}
.edit-action { border: 1px solid var(--blue-200); color: var(--blue-600); }
.edit-action:hover { background: var(--blue-50); border-color: var(--blue-400); }
.delete-action { border: 1px solid var(--danger-border); color: var(--danger); }
.delete-action:hover { background: var(--danger-bg); border-color: #f5a9b3; }

/* ---------- Empty state ---------- */
.empty-state { text-align: center; padding: 45px 20px 50px; }
.empty-icon {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: var(--blue-50);
  color: var(--blue-600);
  margin: 0 auto 14px;
}
.empty-state h3 { font: 700 15px Manrope, sans-serif; margin: 0 0 7px; color: var(--text); }
.empty-state p { font-size: 11px; color: var(--text-muted); margin: 0 0 18px; }
.empty-state .primary-btn { margin: auto; }

/* ---------- Footers ---------- */
.panel-footer {
  border-top: 1px solid var(--border-soft);
  background: var(--surface-alt);
  padding: 13px 24px;
  display: flex;
  justify-content: space-between;
  color: var(--text-muted);
  font-size: 10px;
}
.panel-footer > span:last-child { display: flex; align-items: center; gap: 7px; }
.tiny-dot { width: 6px; height: 6px; }
footer { text-align: center; color: var(--text-faint); font-size: 10px; padding: 22px 0 0; }
footer span { padding: 0 5px; color: #c3cfe2; }

/* ---------- Toast ---------- */
.toast {
  position: fixed;
  top: 85px;
  right: 28px;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 13px 16px;
  border-radius: 9px;
  background: var(--surface);
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--border);
  font-size: 12px;
}
.toast.success { color: #12856a; border-left: 3px solid var(--success); }
.toast.error { color: var(--danger-dark); border-left: 3px solid var(--danger); }
.toast button { border: 0; background: transparent; color: var(--text-muted); display: grid; place-items: center; margin-left: 8px; }
.toast button:hover { color: var(--text-strong); }

/* ---------- Error banner ---------- */
.error-banner {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0 24px 15px;
  padding: 12px;
  border-radius: 8px;
  background: var(--danger-bg);
  border: 1px solid var(--danger-border);
  color: var(--danger-dark);
  font-size: 11px;
}
.error-banner span { flex: 1; }
.error-banner button { border: 0; background: transparent; color: #a3303f; font-weight: 700; }

/* ---------- Modal ---------- */
.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(8, 22, 51, 0.62);
  backdrop-filter: blur(4px);
  display: grid;
  place-items: center;
  padding: 20px;
}
.modal {
  width: min(560px, 100%);
  max-height: 90vh;
  overflow: auto;
  background: var(--surface);
  border-radius: 15px;
  padding: 25px;
  box-shadow: 0 25px 80px rgba(6, 18, 46, 0.35);
}
.modal-heading { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 23px; }
.modal-heading h2 { font: 800 23px Manrope, sans-serif; letter-spacing: -0.7px; margin: 7px 0; color: var(--text); }
.modal-heading p { font-size: 12px; color: var(--text-muted); margin: 0; }

.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 17px; }
.form-grid label { display: flex; flex-direction: column; gap: 7px; font-size: 11px; font-weight: 700; color: var(--text-body); }
.form-grid .full { grid-column: 1 / -1; }
.form-grid input, .form-grid select {
  height: 40px;
  width: 100%;
  padding: 0 11px;
  border: 1px solid #d9e2f0;
  border-radius: 7px;
  outline: 0;
  color: var(--text-strong);
  font-size: 12px;
  background: var(--surface);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.form-grid input:hover, .form-grid select:hover { border-color: var(--blue-300); }
.form-grid input:focus, .form-grid select:focus { border-color: var(--blue-500); box-shadow: var(--focus-ring); }
.form-grid input::placeholder { color: #a9b8d0; font-weight: 400; }
.modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 25px; padding-top: 18px; border-top: 1px solid var(--border-soft); }

/* ---------- Loading spinner ---------- */
.spin { animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ---------- Tablet ---------- */
@media (max-width: 1050px) {
  .sidebar { width: 205px; }
  .main { margin-left: 205px; }
  .content { padding: 30px 25px; }
  .topbar { padding: 0 25px; }
  .stats-grid { gap: 10px; }
  .stat-card { padding: 15px; gap: 10px; }
  th, td { padding-left: 10px; padding-right: 10px; }
  th:first-child, td:first-child { padding-left: 15px; }
  th:last-child, td:last-child { padding-right: 15px; }
}

/* ---------- Mobile ---------- */
@media (max-width: 760px) {
  .sidebar { position: static; width: auto; height: auto; padding: 15px 18px; display: block; }
  .brand { padding: 0; }
  .side-label, .nav-item, .sidebar-bottom { display: none; }
  .main { margin: 0; }
  .topbar { height: 55px; padding: 0 18px; }
  .secure { display: none; }
  .content { padding: 25px 15px; }
  .page-heading { align-items: flex-start; flex-direction: column; }
  .stats-grid { grid-template-columns: 1fr; }
  .stat-card { min-height: 85px; }
  .panel-header { padding: 18px; }
  .toolbar { padding: 0 18px 15px; }
  .panel-footer { padding: 13px 18px; }
  .form-grid { grid-template-columns: 1fr; }
  .form-grid .full { grid-column: auto; }
  .modal { padding: 20px; }
  .table-wrap table { min-width: 850px; }
  .toast { top: 15px; right: 12px; left: 12px; }
  .page-heading .primary-btn { width: 100%; }
}
